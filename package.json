{
  "name": "heisen",
  "productName": "Heisen",
  "version": "0.5.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "cli": "node dist/cli.mjs",
    "package": "node scripts/package.mjs",
    "package:win": "node scripts/package.mjs",
    "filters": "node scripts/filters.mjs",
    "bench:safari": "node --import tsx tests/performance-safari.ts",
    "bench:agent": "node --import tsx tests/bench-agent.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --import tsx tests/desktop.ts && node --import tsx tests/e2e-browser.ts && node --import tsx tests/e2e-data.ts && node --import tsx tests/e2e-agent.ts && node --import tsx tests/e2e-beta.ts && node --import tsx tests/e2e-perf.ts && node --import tsx tests/e2e-privacy.ts && node --import tsx tests/e2e-cli.ts && node --import tsx tests/e2e-security.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@ghostery/adblocker": "2.20.3",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@mariozechner/pi-ai": "0.73.1",
    "@mozilla/readability": "0.6.0",
    "cron-parser": "5.10.3",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "lucide-react": "1.69.0",
    "marked": "18.1.3",
    "openai": "7.51.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts": "7.4.19",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/diff": "7.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "electron-winstaller": "5.4.4",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "png-to-ico": "3.0.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "basic-ftp": "6.2.6",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "electron-winstaller@5.4.4": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  }
}
